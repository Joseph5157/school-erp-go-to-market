{
  "name": "school-erp-demo-automation",
  "version": "0.1.0",
  "private": true,
  "description": "GTM-DEMO-AUTO-01: read-only Playwright demo automation for Everclass ERP walkthroughs (fictional data only).",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "playwright test --project=offline",
    "check": "npm run typecheck && npm test",
    "scenes": "node --experimental-strip-types src/print-scenes.ts",
    "demo:auth": "playwright test --project=auth-admin --project=auth-teacher --project=auth-guardian",
    "demo:all": "playwright test --project=admin --project=teacher --project=guardian",
    "demo:exec8": "playwright test --project=admin --project=teacher --project=guardian --grep @exec8",
    "demo:live30": "playwright test --project=admin --project=teacher --project=guardian --grep @live30"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "typescript": "6.0.3"
  }
}
