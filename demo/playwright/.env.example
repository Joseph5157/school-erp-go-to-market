# Copy to `.env` in this folder (Git-ignored) and fill in locally.
# Never commit a filled-in copy. Keep real values in your password vault.

# Target origin only, e.g. http://localhost:8000 for a local dev server.
# The staging URL is not written in this repository; take it from your private notes.
DEMO_BASE_URL=
# local | fictional-sandbox | staging
DEMO_TARGET_KIND=

# Live-run authorisation. Set to today's date (YYYY-MM-DD) only after the
# owner has authorised this run. It expires at midnight.
DEMO_LIVE_AUTHORIZED_ON=
# Staging only: role of the person who authorised it (e.g. "product owner").
DEMO_LIVE_AUTHORIZED_BY=

# Fictional demo accounts, one per role. Leave blank here.
DEMO_ADMIN_USERNAME=
DEMO_ADMIN_PASSWORD=
DEMO_TEACHER_USERNAME=
DEMO_TEACHER_PASSWORD=
DEMO_GUARDIAN_USERNAME=
DEMO_GUARDIAN_PASSWORD=

# Screenshots on failure. Off by default; never allowed for staging.
# Needs all three: DEMO_CAPTURE=on, today's date, and DEMO_DATA_IS_FICTIONAL=yes.
DEMO_CAPTURE=off
DEMO_CAPTURE_AUTHORIZED_ON=
DEMO_DATA_IS_FICTIONAL=
