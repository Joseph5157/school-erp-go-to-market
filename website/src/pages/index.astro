---
// GTM-WEBSITE-V2 homepage (B-led product-led layout, see PR #18).
// Section order follows the approved blueprint: hero → school-day strip →
// two image-led feature splits → publication → roles → capabilities →
// implementation → FAQ → demo CTA. All wording, including illustration text,
// lives in src/data/home.ts; this file only composes sections.
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroProduct from '../components/home/HeroProduct.astro';
import SchoolDayStrip from '../components/home/SchoolDayStrip.astro';
import FeatureShowcase from '../components/home/FeatureShowcase.astro';
import PublicationFlow from '../components/home/PublicationFlow.astro';
import RolePreview from '../components/home/RolePreview.astro';
import CapabilityGrid from '../components/home/CapabilityGrid.astro';
import ImplementationSteps from '../components/home/ImplementationSteps.astro';
import FaqPreview from '../components/home/FaqPreview.astro';
import DemoCta from '../components/home/DemoCta.astro';
import { site } from '../data/site';
import { features, homeMeta } from '../data/home';
import '../styles/home-v2.css';
---

<BaseLayout
  title={site.wordmark}
  description={homeMeta.description}
>
  <div class="home-v2">
    <HeroProduct />
    <SchoolDayStrip />
    {features.map((feature) => <FeatureShowcase feature={feature} />)}
    <PublicationFlow />
    <RolePreview />
    <CapabilityGrid />
    <ImplementationSteps />
    <FaqPreview />
    <DemoCta />
  </div>
</BaseLayout>
