---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import CtaBand from '../components/CtaBand.astro';
import IconCard from '../components/IconCard.astro';
import StepFlow from '../components/StepFlow.astro';
import Photo from '../components/home/Photo.astro';
import type { Photo as PhotoType } from '../data/home';

const implementationPhoto: PhotoType = {
  src: '/images/product/implementation-meeting.webp',
  width: 1200,
  height: 675,
  alt: 'Illustration of a school principal at his desk going over printed spreadsheets with two members of the implementation team.',
  caption: 'Illustrative image. The people shown are not real staff, guardians or students.',
};

const stages = [
  { title: 'Discover', text: 'Review the school’s priorities, policies and sample formats, and the people who approve decisions.' },
  { title: 'Agree scope', text: 'Separate what the current product already does from any custom work, and agree it in writing.' },
  { title: 'Configure and build', text: 'Set up the school structure, roles and calendar, plus any approved changes.' },
  { title: 'Import and train', text: 'Check and import the school’s data, then run role-based training and practise everyday tasks.' },
  { title: 'School acceptance', text: 'Check agreed workflows together, record the results and resolve anything that blocks launch.' },
  { title: 'Launch and support', text: 'The school approves go-live, and ongoing support follows the written agreement.' },
];
---

<BaseLayout
  title="Implementation"
  description="How a school installation is set up: discovery, agreed scope, configuration, data import and training, school acceptance, then launch and support."
>
  <PageIntro
    eyebrow="Implementation"
    title="Implementation starts with your school"
    lead="We understand how your school works, agree the scope in writing, then set up, import, train and check together before launch."
  >
    <Photo slot="media" photo={implementationPhoto} />
  </PageIntro>

  <section class="section" aria-labelledby="process-heading">
    <div class="wrap timeline-layout">
      <div class="section-head timeline-intro">
        <span class="eyebrow">From first conversation to launch</span>
        <h2 id="process-heading">Six stages from first conversation to launch</h2>
        <p>Six stages, from the first requirements conversation to launch and support.</p>
      </div>
      <StepFlow steps={stages} label="Implementation process in six stages" />
    </div>
  </section>

  <section class="section section-white" aria-labelledby="roles-heading">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Shared responsibilities</span>
        <h2 id="roles-heading">Who does what</h2>
      </div>
      <div class="grid grid-2 responsibility-grid">
        <IconCard icon="setup" title="The school">
          <ul class="check-list">
            <li>Names a coordinator and the people who approve scope and acceptance</li>
            <li>Shares policies and sample formats (fictional or redacted where possible)</li>
            <li>Prepares and cleans the records it is authorised to share</li>
            <li>Reviews validation messages and confirms corrections</li>
            <li>Confirms its own data-protection obligations with its advisers</li>
          </ul>
        </IconCard>
        <IconCard icon="teacher" title="Our implementation team">
          <ul class="check-list">
            <li>Runs the requirements review and writes up the agreed scope</li>
            <li>Configures the installation for the school</li>
            <li>Provides the Excel template and explains each validation message</li>
            <li>Runs the trial and final imports as agreed</li>
            <li>Delivers role-based training for administrators and teachers, plus guardian briefing material</li>
          </ul>
        </IconCard>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="data-heading">
    <div class="wrap implementation-data">
      <div class="implementation-data-copy">
        <span class="eyebrow">Your existing records</span>
        <h2 id="data-heading">Bringing in your data</h2>
        <p>
          Students, guardians and class or section placements can be imported from the product’s Excel template.
          Every row is checked, and problems are shown before anything is saved.
        </p>
        <ul class="check-list">
          <li>A preview of every row before confirmation</li>
          <li>Warnings for possible duplicates and shared phone numbers</li>
          <li>Row and column problem messages you can download</li>
          <li>Records are created only when the whole batch is confirmed</li>
        </ul>
        <p class="mt-lg muted">Data in other formats, and historical attendance or marks, are assessed separately.</p>
      </div>
      <div class="implementation-callouts">
        <h2 class="visually-hidden">Commercial approach and timing</h2>
        <IconCard icon="assessment" title="Commercial approach" class="callout-card">
          <p>
            A one-time setup and implementation fee covering initial data migration and training, followed by
            annual support and maintenance. Hosting costs and responsibilities are identified separately in the
            school-specific proposal, subject to final agreement. Any additional development is quoted
            separately after a written specification.
          </p>
          <p>Prices are given in a written quotation for each school.</p>
        </IconCard>
        <IconCard icon="attendance" title="Timing" class="callout-card">
          <p>
            Timing depends on the school’s size, data quality and how quickly decisions and data are available. We
            agree the stages and any target dates once requirements are confirmed.
          </p>
        </IconCard>
      </div>
    </div>
  </section>

  <CtaBand
    heading="Start with a requirements conversation"
    text="We will ask which workflows matter most, which formats and policies the system must follow, and who will coordinate and approve the scope."
  />
</BaseLayout>
