---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import CtaBand from '../components/CtaBand.astro';
---

<BaseLayout
  title="Who it’s for"
  description="Designed for private-school owners, principals, office teams, teachers and guardians in Telangana and Andhra Pradesh."
>
  <PageIntro
    eyebrow="Who it’s for"
    title="Built for the people who run a private school"
    lead="For private schools in Telangana and Andhra Pradesh that want admissions, attendance, assessments and family access in one place, with each person seeing only their own work."
  />

  <section class="section" aria-labelledby="leaders-heading">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">School leadership</span>
        <h2 id="leaders-heading">For owners, management and principals</h2>
      </div>
      <div class="grid grid-2">
        <article class="card">
          <h3>School owners and management</h3>
          <p>Control, visibility and accountable workflows.</p>
          <ul>
            <li>An overview of students, teachers, classes and guardian access</li>
            <li>Permissions that decide who can do what</li>
            <li>History kept for important records and corrections</li>
            <li>An installation set up for your school, with agreed implementation support</li>
          </ul>
        </article>
        <article class="card">
          <h3>Principals</h3>
          <p>
            A clear view of academic progress before anything reaches families, using an administrator account with
            the permissions the school assigns.
          </p>
          <ul>
            <li>See missing attendance as well as recorded absences</li>
            <li>Check assessment progress and finalise results</li>
            <li>Preview report cards and publish them when reviewed</li>
            <li>Send notices to the whole school, a class or a section</li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <section class="section section-white" aria-labelledby="staff-heading">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Daily users</span>
        <h2 id="staff-heading">For the office, teachers and families</h2>
      </div>
      <div class="grid grid-3">
        <article class="card">
          <span class="card-label">Administrative office</span>
          <h3>Setup and daily operations</h3>
          <ul>
            <li>Academic years, terms, classes, sections and subjects</li>
            <li>Admissions, enrolment and student records</li>
            <li>Teacher accounts and dated assignments</li>
            <li>Excel import, school documents and guardian logins</li>
          </ul>
        </article>
        <article class="card">
          <span class="card-label">Teachers</span>
          <h3>Assigned classes and subjects</h3>
          <ul>
            <li>The day’s work and timetable periods</li>
            <li>Daily attendance for their class (class teachers)</li>
            <li>Marks entry for assigned subjects</li>
            <li>Term remarks for class teachers</li>
          </ul>
        </article>
        <article class="card">
          <span class="card-label">Guardians</span>
          <h3>Their own children only</h3>
          <ul>
            <li>Access granted by the school for each child</li>
            <li>Submitted attendance and monthly calendar</li>
            <li>Published report cards and eligible PDFs</li>
            <li>Relevant school notices</li>
          </ul>
        </article>
      </div>
      <div class="media-rows">
        <div class="media-row">
          <figure class="media-row-photo">
            <img
              src="/images/product/teacher-attendance.webp"
              width="1200"
              height="675"
              style="object-position: 22% center"
              alt="Illustration of a teacher in a green saree taking attendance on her phone in a bright classroom, with students in green-and-white uniforms at their desks."
              loading="lazy"
              decoding="async"
            />
            <figcaption>Illustrative image. The people shown are not real staff, guardians or students.</figcaption>
          </figure>
          <div class="media-row-copy">
            <span class="card-label">Teachers</span>
            <h3>Focus on assigned classes</h3>
            <p>See the day’s work, assigned students and configured timetable periods.</p>
            <p>Take class attendance and enter marks for assigned subjects.</p>
          </div>
        </div>
        <div class="media-row is-reverse">
          <figure class="media-row-photo">
            <img
              src="/images/product/guardian-home-photo.webp"
              width="640"
              height="800"
              style="object-position: center 30%"
              alt="Illustration of a mother and her school-age son at home in the evening, smiling as they look at a phone together."
              loading="lazy"
              decoding="async"
            />
            <figcaption>Illustrative image. The people shown are not real staff, guardians or students.</figcaption>
          </figure>
          <div class="media-row-copy">
            <span class="card-label">Guardians</span>
            <h3>See their own children</h3>
            <p>Sign in to view only the children the school has approved access for.</p>
            <p>Read submitted attendance, published report cards and relevant notices.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="fit-heading">
    <div class="wrap split">
      <div>
        <span class="eyebrow">Is it a good fit?</span>
        <h2 id="fit-heading">A good fit when your school wants to</h2>
        <ul class="check-list">
          <li>Move admissions, registers and marks out of separate files and into one record</li>
          <li>Give teachers access limited to their own classes and subjects</li>
          <li>Review results before they are shared with families</li>
          <li>Give guardians secure, school-approved access to their own children’s information</li>
          <li>Start from existing student spreadsheets</li>
        </ul>
      </div>
      <div>
        <div class="callout">
          <p><strong>Talk to us first if you need:</strong></p>
          <ul>
            <li>Fee collection or online payments</li>
            <li>A native Android or iOS app, or offline working</li>
            <li>Automatic WhatsApp, SMS or email sending</li>
            <li>Transfer certificates or board-specific result calculations</li>
            <li>A Telugu-language interface</li>
          </ul>
          <p>These are not in the current product and would need a separate decision and estimate.</p>
        </div>
      </div>
    </div>
  </section>

  <CtaBand heading="Tell us how your school works today" />
</BaseLayout>
