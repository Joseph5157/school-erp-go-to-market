---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="The page you were looking for could not be found.">
  <section class="page-intro">
    <div class="wrap">
      <span class="eyebrow">Page not found</span>
      <h1>We could not find that page</h1>
      <p class="lead">The link may be out of date. Try one of these instead.</p>
      <div class="btn-row mt-lg">
        <a class="btn btn-primary" href="/">Go to the home page</a>
        <a class="btn btn-secondary" href="/features/">See the features</a>
      </div>
    </div>
  </section>
</BaseLayout>
