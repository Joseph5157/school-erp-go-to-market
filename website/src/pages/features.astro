---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import CtaBand from '../components/CtaBand.astro';
import IconCard from '../components/IconCard.astro';
import StatusList from '../components/StatusList.astro';
import StepFlow from '../components/StepFlow.astro';
import ProductShot from '../components/home/ProductShot.astro';
import Photo from '../components/home/Photo.astro';
import { areaGroups, boundaries } from '../data/site';
import { shots, admissionPhoto } from '../data/home';
import type { IconName, Shot } from '../data/home';

const overviewPhone: Shot = {
  src: '/images/product/overview-phone.webp',
  width: 480,
  height: 533,
  alt: 'Everclass ERP administrator overview for a demo school: term attendance against an 80% target, today’s present and absent count, registers, marks and results still to finish.',
  caption: shots.overview.caption,
  frame: 'phone',
};

// The overview screenshot is already the page's hero, so School administration
// uses the admissions-desk photo instead of repeating it.
const groupShots: Record<string, Shot> = {
  'daily-work': shots.register,
  family: shots.guardian,
  'data-access': overviewPhone,
};

const icons: Record<string, IconName> = {
  M01: 'setup', M02: 'attendance', M03: 'admissions', M04: 'teacher',
  M05: 'attendance', M06: 'assessment', M07: 'teacher', M08: 'guardian',
  M09: 'notice', M10: 'report', M11: 'admissions', M12: 'setup',
};

const publicationSteps = [
  { title: 'Teacher entry', text: 'Marks, Marked Absent results and term remarks.' },
  { title: 'Office review', text: 'Finalise assessments, then preview the publication.' },
  { title: 'Published snapshot', text: 'Guardian view and the eligible report-card PDF.' },
  { title: 'Relevant correction', text: 'The old publication becomes stale until reviewed again.' },
];

const whatsappSteps = [
  { title: 'Consent and access', text: 'Only eligible guardians who have opted in.' },
  { title: 'Prepare message', text: 'The queue holds approved, minimal text.' },
  { title: 'Staff open WhatsApp', text: 'Number and message are prefilled.' },
  { title: 'Staff record the outcome', text: 'Mark it sent, or dismiss it with a reason.' },
];
---

<BaseLayout
  title="Features"
  description="Twelve connected areas covering school setup, admissions, attendance, assessments, report cards, timetables, the guardian portal, notices, documents, Excel import and access control."
>
  <PageIntro
    eyebrow="Features"
    title="Twelve connected areas, one school system"
    lead="The twelve areas below are in the current product. Access to each depends on a person’s permissions and current assignments. Requests that are not included are listed at the end of the page."
  >
    <nav aria-label="Feature groups">
      <ul class="jump-links">
        {areaGroups.map((group) => <li><a href={`#${group.slug}`}>{group.title}</a></li>)}
        <li><a href="#not-included">Not included</a></li>
      </ul>
    </nav>
    <ProductShot slot="media" shot={shots.overview} eager />
  </PageIntro>

  <div aria-label="Product areas">
    {areaGroups.map((group, index) => (
      <section class:list={['section', 'feature-group', { 'section-white': index % 2 === 1 }]} id={group.slug} aria-labelledby={`${group.slug}-heading`}>
        <div class="wrap">
          <div class:list={['feature-group-lead', { 'is-reverse': index % 2 === 1 }]}>
            <div class="feature-group-copy">
              <span class="eyebrow">Product area {String(index + 1).padStart(2, '0')}</span>
              <h2 id={`${group.slug}-heading`}>{group.title}</h2>
              <p>{group.intro}</p>
            </div>
            <div class="feature-group-visual">
              {groupShots[group.slug] ? <ProductShot shot={groupShots[group.slug]} /> : <Photo photo={admissionPhoto} />}
            </div>
          </div>
          <div class="feature-card-grid">
            {group.areas.map((area) => (
              <IconCard icon={icons[area.id]} title={area.title} summary={area.summary} tag={area.users}>
                <ul class="feature-ticks">
                  {area.points.map((point) => <li>{point}</li>)}
                </ul>
              </IconCard>
            ))}
          </div>
        </div>
      </section>
    ))}
  </div>

  <section class="section workflow-section" aria-labelledby="workflows-heading">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Two workflows in detail</span>
        <h2 id="workflows-heading">Controlled publication and staff-assisted messages</h2>
      </div>
      <div class="workflow-grid">
        <article class="workflow-card">
          <div class="workflow-card-head">
            <span class="icon-card-symbol"><span aria-hidden="true">01</span></span>
            <div>
              <h3>Report card publication</h3>
              <p>The office checks and explicitly publishes a report card before guardians can see it.</p>
            </div>
          </div>
          <StepFlow steps={publicationSteps} label="Report card publication flow" compact />
        </article>
        <article class="workflow-card">
          <div class="workflow-card-head">
            <span class="icon-card-symbol"><span aria-hidden="true">02</span></span>
            <div>
              <h3>WhatsApp Assist</h3>
              <p>The system prepares the message; a member of staff sends it in WhatsApp.</p>
            </div>
          </div>
          <StepFlow steps={whatsappSteps} label="WhatsApp Assist flow" compact />
        </article>
      </div>
    </div>
  </section>

  <section class="section section-white" id="not-included" aria-labelledby="not-included-heading">
    <div class="wrap boundaries-layout">
      <div class="section-head boundaries-intro">
        <span class="eyebrow">Clear boundaries</span>
        <h2 id="not-included-heading">Not in the current product</h2>
        <p>These requests need a separate decision, estimate or development. Listing them here does not mean they are available today or included in a standard proposal.</p>
        <p class="muted small">The interface and student names are in English. PDFs include Telugu fonts, but the interface is not translated into Telugu.</p>
      </div>
      <StatusList items={boundaries} label="Requests outside the current product and their position" />
    </div>
  </section>

  <CtaBand heading="Check the features against your school’s needs" />
</BaseLayout>
