---
// Compact eight-capability grid linking into the Features page groups,
// closed by a dark call-to-action card.
import SectionIntro from './SectionIntro.astro';
import Icon from './Icon.astro';
import { demoHref } from '../../data/site';
import { capabilities, capabilitiesCta, capabilitiesIntro } from '../../data/home';
---

<section class="v2-section v2-capabilities" aria-labelledby="v2-cap-heading">
  <div class="wrap">
    <SectionIntro id="v2-cap-heading" intro={capabilitiesIntro} showLink={false} />
    <ul class="v2-capability-grid">
      {capabilities.map((c) => (
        <li>
          <a class="v2-capability" href={c.href}>
            <span class="v2-capability-icon"><Icon name={c.icon} /></span>
            <strong>{c.title}</strong>
            <span class="v2-capability-text">{c.text}</span>
          </a>
        </li>
      ))}
      <li class="v2-cap-cta">
        <strong>{capabilitiesCta.heading}</strong>
        <span>{capabilitiesCta.text}</span>
        <a class="v2-btn v2-btn-on-dark" href={demoHref}>{capabilitiesCta.label} <span aria-hidden="true">↗</span></a>
      </li>
    </ul>
    {capabilitiesIntro.link && (
      <p class="v2-after-link">
        <a class="v2-inline-link" href={capabilitiesIntro.link.href}>{capabilitiesIntro.link.label} <span aria-hidden="true">→</span></a>
      </p>
    )}
  </div>
</section>
