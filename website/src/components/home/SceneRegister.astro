---
// Attendance illustration: a submitted section register, with recorded absence
// kept distinct from a register that is still missing. Mirrors area M05.
import IllustrationPanel from './IllustrationPanel.astro';
import { scenes } from '../../data/home';

const s = scenes.register;
---

<IllustrationPanel label={s.label} motif="register" tone="sage">
  <div class="v2-mock-card" role="img" aria-label={s.ariaLabel}>
    <div class="v2-mock-head" aria-hidden="true">
      <div>
        <span class="v2-mock-eyebrow">{s.eyebrow}</span>
        <strong>{s.title}</strong>
      </div>
      <span class="v2-mock-status">{s.status}</span>
    </div>
    <div class="v2-mock-register" aria-hidden="true">
      {s.rows.map((r) => (
        <>
          <span class="v2-mock-cell">{r.roll}</span>
          <span class:list={['v2-mock-cell', 'state', { 'is-absent': r.absent }]}>{r.mark}</span>
        </>
      ))}
    </div>
  </div>
  <div class="v2-mock-card v2-mock-chip" aria-hidden="true">
    <span class="v2-mock-eyebrow">{s.chipEyebrow}</span>
    <strong>{s.chipText}</strong>
  </div>
</IllustrationPanel>
