---
// Admissions illustration: explicit decision, then a separate dated enrolment.
// Fictional and nameless; mirrors catalogue area M03.
import IllustrationPanel from './IllustrationPanel.astro';
import { scenes } from '../../data/home';

const s = scenes.admission;
---

<IllustrationPanel label={s.label} motif="record" tone="mint">
  <div class="v2-mock-card v2-mock-back" aria-hidden="true">
    <div class="v2-mock-head"><strong>{s.backTitle}</strong><span class="v2-mock-tag">{s.backTag}</span></div>
  </div>
  <div class="v2-mock-card" role="img" aria-label={s.ariaLabel}>
    <div class="v2-mock-head" aria-hidden="true">
      <div>
        <span class="v2-mock-eyebrow">{s.eyebrow}</span>
        <strong>{s.title}</strong>
      </div>
      <span class="v2-mock-tag">{s.tag}</span>
    </div>
    <ol class="v2-mock-steps" aria-hidden="true">
      {s.steps.map((step) => (
        <li><b>{step.title}</b><span class:list={{ 'v2-mock-status': step.status }}>{step.note}</span></li>
      ))}
    </ol>
  </div>
</IllustrationPanel>
