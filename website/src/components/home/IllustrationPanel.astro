---
// Mint-to-forest illustration ground with two decorative depth planes
// (outline school objects drawn in SVG) and a visible "illustration" caption.
// The interface card itself goes in the default slot.
import { scenes } from '../../data/home';

interface Props {
  label: string;
  tone?: 'mint' | 'sage';
  motif?: 'register' | 'record';
}

const { label, tone = 'mint', motif = 'record' } = Astro.props;
---

<figure class:list={['v2-visual-panel', `v2-visual-panel--${tone}`]}>
  <svg class="v2-motif" viewBox="0 0 400 300" fill="none" aria-hidden="true" focusable="false">
    {motif === 'register' && (
      <g stroke="currentColor" stroke-width="1.2">
        <rect x="236" y="22" width="140" height="176" rx="10" />
        <path d="M236 58h140M272 22v176M236 94h140M236 130h140M236 166h140" />
        <circle cx="254" cy="76" r="5" /><circle cx="254" cy="112" r="5" /><circle cx="254" cy="148" r="5" />
        <rect x="18" y="198" width="120" height="84" rx="10" />
        <path d="M18 222h120M48 198v-12M108 198v-12" />
      </g>
    )}
    {motif === 'record' && (
      <g stroke="currentColor" stroke-width="1.2">
        <path d="M262 18h86l30 30v160H262z" />
        <path d="M348 18v30h30M282 84h76M282 112h76M282 140h50" />
        <rect x="20" y="196" width="140" height="86" rx="10" />
        <circle cx="52" cy="232" r="14" />
        <path d="M78 224h60M78 244h40" />
      </g>
    )}
  </svg>
  <span class="v2-visual-highlight">{label}</span>
  <div class="v2-visual-stack">
    <slot />
  </div>
  <figcaption class="v2-mock-caption">{scenes.caption}</figcaption>
</figure>
