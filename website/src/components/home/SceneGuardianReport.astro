---
// Guardian view illustration (browser frame, not a native app): a published
// term report card and eligible PDF download. Mirrors areas M06 and M08.
import { scenes } from '../../data/home';

const s = scenes.guardian;
---

<figure class="v2-guardian-figure">
  <div class="v2-browser" role="img" aria-label={s.ariaLabel}>
    <div class="v2-browser-bar" aria-hidden="true"><i></i><i></i><i></i><span>{s.bar}</span></div>
    <div class="v2-browser-body" aria-hidden="true">
      <div class="v2-mock-head">
        <div>
          <span class="v2-mock-eyebrow">{s.eyebrow}</span>
          <strong>{s.title}</strong>
        </div>
        <span class="v2-mock-status">{s.status}</span>
      </div>
      {s.lines.map((l) => (
        <div class="v2-mock-line"><span>{l.subject}</span><b>{l.marks}</b></div>
      ))}
      <span class="v2-mock-button">{s.button}</span>
    </div>
  </div>
  <figcaption class="v2-guardian-caption">{scenes.caption}</figcaption>
</figure>
