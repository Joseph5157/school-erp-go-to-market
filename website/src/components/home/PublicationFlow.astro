---
// Dark publication band: four stages, guardian visibility stated per stage,
// plus an illustrative guardian view of the published result.
import SceneGuardianReport from './SceneGuardianReport.astro';
import { publicationStages } from '../../data/home';
---

<section class="v2-section v2-publication" aria-labelledby="v2-publish-heading">
  <div class="wrap">
    <div class="v2-publication-header">
      <div>
        <span class="v2-label">Review before release</span>
        <h2 id="v2-publish-heading">Marks stay private until the school publishes</h2>
      </div>
      <p>
        Teachers enter results. The office finalises the assessment, previews the report card and explicitly
        publishes it. Only then does it appear in the guardian portal. If a relevant correction is made later,
        the old publication is flagged for review.
      </p>
    </div>
    <div class="v2-publication-body">
      <ol class="v2-pub-flow" aria-label="Report card publication stages">
        {publicationStages.map((stage, i) => (
          <li class:list={['v2-pub-stage', { 'is-live': stage.live }]}>
            <small>Step {i + 1} · {stage.who}</small>
            <strong>{stage.action}</strong>
            <span class="v2-pub-visibility">{stage.visibility}</span>
          </li>
        ))}
      </ol>
      <SceneGuardianReport />
    </div>
    <a class="v2-publication-link v2-inline-link" href="/features/#daily-work">
      Read about assessments and report cards <span aria-hidden="true">→</span>
    </a>
  </div>
</section>
