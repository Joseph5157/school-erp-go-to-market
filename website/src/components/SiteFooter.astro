---
import { site, nav, demoHref, requirementsHref } from '../data/site';
---

<footer class="site-footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <a class="wordmark" href="/">
          <span class="wordmark-name">{site.wordmark}</span>
          <span class="wordmark-note">{site.wordmarkNote}</span>
        </a>
        <p class="mt-lg">
          School administration software for private schools in Telangana and Andhra Pradesh: admissions,
          attendance, assessments, report cards and a guardian portal in one connected record.
        </p>
      </div>
      <div>
        <h2>Pages</h2>
        <ul>
          <li><a href="/">Home</a></li>
          {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
      </div>
      <div>
        <h2>Talk to us</h2>
        <ul>
          <li><a href={demoHref}>Request a demo</a></li>
          <li><a href={requirementsHref}>Discuss your requirements</a></li>
        </ul>
        <p class="mt-lg small">Contact details: pending approval.</p>
      </div>
    </div>
    <div class="footer-base">
      <p>Draft website for internal review. Not published and not for distribution.</p>
      <p>Company name, product name, logo and contact details are provisional.</p>
    </div>
  </div>
</footer>
